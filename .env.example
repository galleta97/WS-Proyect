# Copia este archivo como .env y llena lo que necesites.
# Todo es opcional: si dejas un canal sin configurar, esas alertas
# simplemente no se envían por ahí (pero sí quedan guardadas en la tabla
# de alertas y visibles en /alerts).

# --- Watcher de demo (Fase 3) ---
# Actívalo para ver alertas generarse solas cada cierto tiempo, sin
# necesitar un scraper real todavía.
ENABLE_PRICE_WATCHER=false
PRICE_WATCHER_INTERVAL_SECONDS=30

# --- Email (smtplib) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=

# --- Webhooks ---
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
